+// updateEbpfCgroup manages the cgroup-eBPF TCP redirector lifecycle.
+// It feeds the phone's own TCP traffic into mihomo's redir-port via
+// faked SO_ORIGINAL_DST, independent of the "ebpf" (PR #3175) inbound.
+func updateEbpfCgroup(config LC.EbpfCgroup) error {
+	if !config.Enable {
+		if ebpfCgroupMgr != nil {
+			err := ebpfCgroupMgr.Close()
+			ebpfCgroupMgr = nil
+			return err
+		}
+		return nil
+	}
+	if ebpfCgroupMgr != nil && ebpfCgroupConfig.Equal(config) {
+		return nil
+	}
+	if ebpfCgroupMgr != nil {
+		if err := ebpfCgroupMgr.Close(); err != nil {
+			return err
+		}
+		ebpfCgroupMgr = nil
+	}
+	manager, err := ebpfcgroup.Start(ebpfcgroup.Config{
+		Enable:     config.Enable,
+		RedirPort:  config.RedirPort,
+		CgroupPath: config.CgroupPath,
+	})
+	if err != nil {
+		return err
+	}
+	ebpfCgroupMgr = manager
+	ebpfCgroupConfig = config
+	return nil
+}
