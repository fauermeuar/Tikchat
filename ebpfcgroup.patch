+// parseEbpfCgroup validates the cgroup-eBPF redirector config. It is
+// intentionally minimal: enable + redir-port (+ optional cgroup-path).
+func parseEbpfCgroup(raw RawEbpfCgroup) (LC.EbpfCgroup, error) {
+	if !raw.Enable {
+		return LC.EbpfCgroup{}, nil
+	}
+	if raw.RedirPort < 1 || raw.RedirPort > 65535 {
+		return LC.EbpfCgroup{}, fmt.Errorf("ebpf-cgroup.redir-port must be in 1..65535: %d", raw.RedirPort)
+	}
+	return LC.EbpfCgroup{
+		Enable:     true,
+		RedirPort:  uint16(raw.RedirPort),
+		CgroupPath: raw.CgroupPath,
+	}, nil
+}
